{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braven-pvm.github.io/braven_charts/schemas/public_catalog.schema.json",
  "title": "Braven Charts public documentation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "showcaseBaseUrl",
    "repositoryBaseUrl",
    "apiBaseUrl",
    "features",
    "chartFamilies",
    "guides",
    "snippets",
    "gallery"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "showcaseBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "repositoryBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "apiBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "features": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "chartFamilies": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/chartFamily"
      }
    },
    "guides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/guide"
      }
    },
    "snippets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/snippet"
      }
    },
    "gallery": {
      "type": "array",
      "minItems": 12,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/galleryItem"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "page"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "asset", "page"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "pattern": "^doc/screenshots/.+\\.(png|gif|jpg|jpeg|webp)$"
        },
        "page": {
          "$ref": "#/$defs/id"
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "type": "string",
          "minLength": 1
        },
        "animated": {
          "type": "boolean"
        }
      }
    },
    "chartFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "group",
        "summary",
        "bestFor",
        "page",
        "guide",
        "apiSymbols",
        "pairAsset",
        "primaryExample"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "enum": ["Cartesian", "Financial", "Partition radial", "Polar"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "bestFor": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "$ref": "#/$defs/id"
        },
        "guide": {
          "type": "string",
          "minLength": 1
        },
        "apiSymbols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pairAsset": {
          "type": "string",
          "minLength": 1
        },
        "primaryExample": {
          "allOf": [
            {
              "$ref": "#/$defs/example"
            },
            {
              "required": ["alt"]
            }
          ]
        },
        "secondaryExample": {
          "$ref": "#/$defs/example"
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "group", "summary"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "enum": [
            "Get started",
            "Interaction and display",
            "Data, authoring, and live updates",
            "Workbench, artifacts, and export",
            "API reference"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "apiPath": {
          "type": "string"
        },
        "snippet": {
          "$ref": "#/$defs/id"
        }
      },
      "anyOf": [
        {
          "required": ["page"]
        },
        {
          "required": ["path"]
        },
        {
          "required": ["apiPath"]
        },
        {
          "required": ["snippet"]
        }
      ]
    },
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path",
        "startMarker",
        "endMarker",
        "language"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "startMarker": {
          "type": "string",
          "minLength": 1
        },
        "endMarker": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "const": "dart"
        }
      }
    },
    "galleryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "group", "alt", "asset", "page"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "enum": [
            "Analytical compositions",
            "Interaction and live behavior",
            "Density and navigation",
            "Business and financial",
            "Uncertainty and ranges",
            "Radial and polar",
            "Themes and presentation"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "pattern": "^doc/screenshots/.+\\.(png|gif|jpg|jpeg|webp)$"
        },
        "page": {
          "$ref": "#/$defs/id"
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "animated": {
          "type": "boolean"
        }
      }
    }
  }
}
